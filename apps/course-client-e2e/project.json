{
  "name": "course-client-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/course-client-e2e/src",
  "projectType": "application",
  "tags": ["scope:course-client"],
  "implicitDependencies": ["course-client"],
  "targets": {
    "e2e": {
      "options": {
        "config-file": "./cypress.config.ts"
      }
    },
    "bddgen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/libs/course-client/feature/src/lib/login/login.feature"
      ],
      "outputs": ["{projectRoot}/.features-gen"],
      "options": {
        "command": "corepack pnpm exec bddgen -c apps/course-client-e2e/playwright.config.ts"
      }
    }
  }
}
