{
  "name": "course-platform-analog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/course-platform-analog/src",
  "tags": ["type:app", "scope:course-client", "scope:course-admin"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/course-platform-analog"],
      "defaultConfiguration": "production",
      "options": {
        "command": "vite build --config apps/course-platform-analog/vite.config.ts --outDir ../../dist/apps/course-platform-analog/client",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      },
      "configurations": {
        "development": {
          "args": ["--mode=development", "--sourcemap"]
        },
        "production": {
          "args": ["--mode=production"]
        }
      },
      "dependsOn": ["build-styles"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "vite --config apps/course-platform-analog/vite.config.ts --port 4200",
        "readyWhen": "Local:"
      },
      "configurations": {
        "development": {
          "args": ["--mode=development"]
        },
        "production": {
          "args": ["--mode=production"]
        }
      },
      "dependsOn": ["build-styles"],
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "course-platform-analog:build"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.{ts,html}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/course-platform-analog",
        "command": "vitest run --config vite.config.ts",
        "forwardAllArgs": false
      }
    },
    "build-styles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/libs/shared/ui/styles/src/lib/**/*.scss",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": ["{projectRoot}/src/global-styling.generated.css"],
      "options": {
        "command": "npm run build:styles",
        "cwd": "."
      }
    }
  }
}
