  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test",
    "test:pr": "npm run affected:test -- --base origin/main --head HEAD --parallel",
    "nx-decorate-angular-cli": "node ./decorate-angular-cli.js",
    "lint": "nx run-many -t lint",
    "e2e": "nx e2e",
    "build:course-platform-analog": "NODE_OPTIONS=\"--max-old-space-size=16384\" nx build course-platform-analog",
    "build:analogjs-demo": "NODE_OPTIONS=\"--max-old-space-size=16384\" nx build analogjs-demo-analogjs-demo",
    "affected:apps": "nx show projects --affected --type app",
    "affected:libs": "nx show projects --affected --type lib",
    "affected:build": "nx affected -t build",
    "affected:e2e": "nx affected -t e2e",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "affected:dep-graph": "nx graph --affected",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "workspaceschematic": "nx workspace-schematic",
    "dep-graph": "nx graph",
    "help": "nx help",
    "prepare": "husky",
    "drizzle-generate": "cd ./libs/shared/domain/trpc-server/src/lib/drizzle && drizzle-kit generate",
    "drizzle-pull": "cd ./libs/shared/domain/trpc-server/src/lib/drizzle && drizzle-kit pull",
    "drizzle-migrate": "cd ./libs/shared/domain/trpc-server/src/lib/drizzle && drizzle-kit migrate",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ludemann-consulting-aps --project javascript-angular ./dist && sentry-cli sourcemaps upload --org ludemann-consulting-aps --project javascript-angular ./dist",
    "test:e2e": "nx run-many -t e2e -p course-client-e2e course-admin-e2e --configuration=production",
    "test:e2e:playwright": "nx run-many -t e2e-playwright -p course-client-e2e course-admin-e2e",
    "build:styles": "sass --load-path=libs/shared/ui/styles/src/lib --load-path=node_modules --no-source-map --quiet libs/shared/ui/styles/src/lib/global-styling.scss apps/course-platform-analog/src/global-styling.generated.css"
  },
